{
  "name": "mapmyroots",
  "version": "1.0.0",
  "description": "Free online family tree builder and genealogy software with interactive canvas-based visualization.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --config testing/playwright.config.js",
    "generate-icons": "node scripts/generate-icons.mjs",
    "subset-fonts": "glyphhanger http://localhost:4321 --subset=public/assets/fonts/*.woff2 --formats=woff2 --output=public/assets/fonts/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-e-a-d/mapmyroots.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/h-e-a-d/mapmyroots/issues"
  },
  "homepage": "https://mapmyroots.com",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/cli": "^4.11.3",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.53.2",
    "@types/node": "^24.0.10",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/ui": "^3.2.4",
    "astro": "^7.4.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "astro-og-canvas": "^0.13.2",
    "dompurify": "^3.3.0",
    "fflate": "^0.8.3",
    "jspdf": "4.2.1",
    "parse-gedcom": "^2.0.1",
    "pdfjs-dist": "^4.10.38"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "@vite-pwa/astro": {
      "astro": "$astro"
    }
  }
