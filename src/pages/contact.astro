---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/content-pages.css';
import { t, localizedPath, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const title = t(locale, 'pages.contact.meta.title');
const description = t(locale, 'pages.contact.meta.description');

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mapmyroots.com/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://mapmyroots.com/contact" }
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact"
  locale={locale}
  jsonLd={[breadcrumbSchema]}
>
    <div class="contact-container">
      <div class="contact-hero">
        <h1>{t(locale, 'pages.contact.hero.title')}</h1>
        <p>{t(locale, 'pages.contact.hero.subtitle')}</p>
      </div>

      <div class="contact-grid">
        <div class="contact-card">
          <div class="contact-icon">📧</div>
          <h2>{t(locale, 'pages.contact.email.title')}</h2>
          <p>{t(locale, 'pages.contact.email.description')}</p>
          <a href="mailto:support@mapmyroots.com">support@mapmyroots.com</a>
        </div>

        <div class="contact-card">
          <div class="contact-icon">❓</div>
          <h2>{t(locale, 'pages.contact.faq.title')}</h2>
          <p>{t(locale, 'pages.contact.faq.description')}</p>
          <a href={`${localizedPath(locale, '/')}#faq`}>{t(locale, 'pages.contact.faq.link')}</a>
        </div>

        <div class="contact-card">
          <div class="contact-icon">📚</div>
          <h2>{t(locale, 'pages.contact.resources.title')}</h2>
          <p>{t(locale, 'pages.contact.resources.description')}</p>
          <a href="/glossary">{t(locale, 'pages.contact.resources.link')}</a>
        </div>
      </div>

      <div class="faq-link">
        <h2>{t(locale, 'pages.contact.response.title')}</h2>
        <p>{t(locale, 'pages.contact.response.content')}</p>
      </div>
    </div>
</BaseLayout>
