---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/content-pages.css';
import { t, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const title = t(locale, 'pages.privacy.meta.title');
const description = t(locale, 'pages.privacy.meta.description');
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/privacy"
  locale={locale}
>
    <div class="legal-container">
      <div class="legal-header">
        <h1>{t(locale, 'pages.privacy.title')}</h1>
        <p class="last-updated">{t(locale, 'pages.privacy.last_updated')}</p>
        {locale !== 'en' && <p class="translation-notice">{t(locale, 'pages.legal.translation_notice')}</p>}
      </div>

      <div class="legal-content">
        <div class="highlight-box">
          <p><strong>{t(locale, 'pages.privacy.tldr.title')}</strong> <span>{t(locale, 'pages.privacy.tldr.content')}</span></p>
        </div>

        <h2>{t(locale, 'pages.privacy.introduction.title')}</h2>
        <p>{t(locale, 'pages.privacy.introduction.content')}</p>

        <h2>{t(locale, 'pages.privacy.data_collection.title')}</h2>

        <h3>{t(locale, 'pages.privacy.data_collection.family_tree.title')}</h3>
        <p set:html={t(locale, 'pages.privacy.data_collection.family_tree.content')} />
        <ul>
          <li>{t(locale, 'pages.privacy.data_collection.family_tree.local')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.family_tree.no_upload')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.family_tree.no_access')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.family_tree.control')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.family_tree.export')}</li>
        </ul>

        <h3>{t(locale, 'pages.privacy.data_collection.analytics.title')}</h3>
        <p>{t(locale, 'pages.privacy.data_collection.analytics.content')}</p>
        <ul>
          <li>{t(locale, 'pages.privacy.data_collection.analytics.pages')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.analytics.referrer')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.analytics.device')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.analytics.location')}</li>
          <li>{t(locale, 'pages.privacy.data_collection.analytics.features')}</li>
        </ul>
        <p set:html={t(locale, 'pages.privacy.data_collection.analytics.no_content')} />

        <h3>{t(locale, 'pages.privacy.data_collection.cookies.title')}</h3>
        <p>{t(locale, 'pages.privacy.data_collection.cookies.content')}</p>
        <ul>
          <li><strong>{t(locale, 'pages.privacy.data_collection.cookies.essential.title')}</strong> <span>{t(locale, 'pages.privacy.data_collection.cookies.essential.content')}</span></li>
          <li set:html={t(locale, 'pages.privacy.data_collection.cookies.analytics')} />
        </ul>

        <h2>{t(locale, 'pages.privacy.no_account.title')}</h2>
        <p>{t(locale, 'pages.privacy.no_account.content')}</p>
        <ul>
          <li>{t(locale, 'pages.privacy.no_account.email')}</li>
          <li>{t(locale, 'pages.privacy.no_account.name')}</li>
          <li>{t(locale, 'pages.privacy.no_account.payment')}</li>
          <li>{t(locale, 'pages.privacy.no_account.phone')}</li>
        </ul>
        <p>{t(locale, 'pages.privacy.no_account.anonymous')}</p>

        <h2>{t(locale, 'pages.privacy.data_security.title')}</h2>
        <p>{t(locale, 'pages.privacy.data_security.content')}</p>
        <ul>
          <li>{t(locale, 'pages.privacy.data_security.responsible')}</li>
          <li>{t(locale, 'pages.privacy.data_security.export')}</li>
          <li>{t(locale, 'pages.privacy.data_security.browser')}</li>
          <li>{t(locale, 'pages.privacy.data_security.clear')}</li>
        </ul>

        <h2>{t(locale, 'pages.privacy.third_party.title')}</h2>
        <p>{t(locale, 'pages.privacy.third_party.content')}</p>
        <ul>
          <li><strong>{t(locale, 'pages.privacy.third_party.google.title')}</strong> <span set:html={t(locale, 'pages.privacy.third_party.google.content')} /></li>
          <li set:html={t(locale, 'pages.privacy.third_party.cloudflare')} />
          <li><strong>{t(locale, 'pages.privacy.third_party.fonts.title')}</strong> <span>{t(locale, 'pages.privacy.third_party.fonts.content')}</span></li>
        </ul>

        <h2>{t(locale, 'pages.privacy.your_rights.title')}</h2>
        <p>{t(locale, 'pages.privacy.your_rights.intro')}</p>
        <ul>
          <li><strong>{t(locale, 'pages.privacy.your_rights.access.title')}</strong> <span>{t(locale, 'pages.privacy.your_rights.access.content')}</span></li>
          <li><strong>{t(locale, 'pages.privacy.your_rights.export.title')}</strong> <span>{t(locale, 'pages.privacy.your_rights.export.content')}</span></li>
          <li><strong>{t(locale, 'pages.privacy.your_rights.delete.title')}</strong> <span>{t(locale, 'pages.privacy.your_rights.delete.content')}</span></li>
          <li><strong>{t(locale, 'pages.privacy.your_rights.modify.title')}</strong> <span>{t(locale, 'pages.privacy.your_rights.modify.content')}</span></li>
        </ul>

        <h2>{t(locale, 'pages.privacy.children.title')}</h2>
        <p>{t(locale, 'pages.privacy.children.content')}</p>

        <h2>{t(locale, 'pages.privacy.international.title')}</h2>
        <p>{t(locale, 'pages.privacy.international.content')}</p>

        <h2>{t(locale, 'pages.privacy.data_retention.title')}</h2>
        <p>{t(locale, 'pages.privacy.data_retention.content')}</p>
        <ul>
          <li>{t(locale, 'pages.privacy.data_retention.clear_browser')}</li>
          <li>{t(locale, 'pages.privacy.data_retention.clear_app')}</li>
          <li>{t(locale, 'pages.privacy.data_retention.uninstall')}</li>
        </ul>
        <p>{t(locale, 'pages.privacy.data_retention.export')}</p>

        <h2>{t(locale, 'pages.privacy.changes.title')}</h2>
        <p>{t(locale, 'pages.privacy.changes.content')}</p>

        <h2>{t(locale, 'pages.privacy.gdpr.title')}</h2>
        <p>{t(locale, 'pages.privacy.gdpr.content')}</p>
        <ul>
          <li set:html={t(locale, 'pages.privacy.gdpr.local')} />
          <li set:html={t(locale, 'pages.privacy.gdpr.control')} />
          <li set:html={t(locale, 'pages.privacy.gdpr.transparency')} />
          <li set:html={t(locale, 'pages.privacy.gdpr.consent')} />
        </ul>

        <h2>{t(locale, 'pages.privacy.ccpa.title')}</h2>
        <p>{t(locale, 'pages.privacy.ccpa.content')}</p>
        <ul>
          <li>{t(locale, 'pages.privacy.ccpa.know')}</li>
          <li>{t(locale, 'pages.privacy.ccpa.delete')}</li>
          <li>{t(locale, 'pages.privacy.ccpa.opt_out')}</li>
        </ul>

        <div class="contact-info">
          <h2>{t(locale, 'pages.privacy.contact.title')}</h2>
          <p>{t(locale, 'pages.privacy.contact.intro')}</p>
          <ul>
            <li><strong>{t(locale, 'pages.privacy.contact.email_label')}</strong> <a href="mailto:support@mapmyroots.com">support@mapmyroots.com</a></li>
            <li><strong>{t(locale, 'pages.privacy.contact.website_label')}</strong> <a href="https://mapmyroots.com">mapmyroots.com</a></li>
          </ul>
        </div>
      </div>
    </div>
</BaseLayout>
