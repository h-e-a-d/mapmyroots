---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/content-pages.css';
import { t, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const title = t(locale, 'pages.terms.meta.title');
const description = t(locale, 'pages.terms.meta.description');
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/terms"
  locale={locale}
>
    <div class="legal-container">
      <div class="legal-header">
        <h1>{t(locale, 'pages.terms.title')}</h1>
        <p class="last-updated">{t(locale, 'pages.terms.last_updated')}</p>
        {locale !== 'en' && <p class="translation-notice">{t(locale, 'pages.legal.translation_notice')}</p>}
      </div>

      <div class="legal-content">
        <div class="highlight-box">
          <p set:html={t(locale, 'pages.terms.intro')} />
        </div>

        <h2>{t(locale, 'pages.terms.acceptance.title')}</h2>
        <p>{t(locale, 'pages.terms.acceptance.content')}</p>

        <h2>{t(locale, 'pages.terms.description.title')}</h2>
        <p>{t(locale, 'pages.terms.description.intro')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.description.create')}</li>
          <li>{t(locale, 'pages.terms.description.store')}</li>
          <li>{t(locale, 'pages.terms.description.export')}</li>
          <li>{t(locale, 'pages.terms.description.customize')}</li>
        </ul>
        <p>{t(locale, 'pages.terms.description.free')}</p>

        <h2>{t(locale, 'pages.terms.account.title')}</h2>
        <p>{t(locale, 'pages.terms.account.content')}</p>

        <h2>{t(locale, 'pages.terms.acceptable_use.title')}</h2>

        <h3>{t(locale, 'pages.terms.acceptable_use.permitted.title')}</h3>
        <p>{t(locale, 'pages.terms.acceptable_use.permitted.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.acceptable_use.permitted.personal')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.permitted.education')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.permitted.reunions')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.permitted.preservation')}</li>
        </ul>

        <h3>{t(locale, 'pages.terms.acceptable_use.prohibited.title')}</h3>
        <p>{t(locale, 'pages.terms.acceptable_use.prohibited.intro')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.harm')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.unauthorized')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.interfere')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.automated')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.reverse')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.violate')}</li>
          <li>{t(locale, 'pages.terms.acceptable_use.prohibited.infringe')}</li>
        </ul>

        <h2>{t(locale, 'pages.terms.data_ownership.title')}</h2>

        <h3>{t(locale, 'pages.terms.data_ownership.your_data.title')}</h3>
        <p>{t(locale, 'pages.terms.data_ownership.your_data.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.data_ownership.your_data.ownership')}</li>
          <li>{t(locale, 'pages.terms.data_ownership.your_data.control')}</li>
          <li>{t(locale, 'pages.terms.data_ownership.your_data.responsibility')}</li>
          <li>{t(locale, 'pages.terms.data_ownership.your_data.backup')}</li>
          <li>{t(locale, 'pages.terms.data_ownership.your_data.loss')}</li>
        </ul>

        <h3>{t(locale, 'pages.terms.data_ownership.privacy.title')}</h3>
        <p>{t(locale, 'pages.terms.data_ownership.privacy.content')}</p>

        <h2>{t(locale, 'pages.terms.intellectual_property.title')}</h2>

        <h3>{t(locale, 'pages.terms.intellectual_property.our.title')}</h3>
        <p>{t(locale, 'pages.terms.intellectual_property.our.content')}</p>

        <h3>{t(locale, 'pages.terms.intellectual_property.open_source.title')}</h3>
        <p>{t(locale, 'pages.terms.intellectual_property.open_source.content')}</p>

        <h2>{t(locale, 'pages.terms.disclaimers.title')}</h2>

        <h3>{t(locale, 'pages.terms.disclaimers.as_is.title')}</h3>
        <p>{t(locale, 'pages.terms.disclaimers.as_is.content')}</p>

        <h3>{t(locale, 'pages.terms.disclaimers.no_guarantee.title')}</h3>
        <p>{t(locale, 'pages.terms.disclaimers.no_guarantee.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.disclaimers.no_guarantee.uninterrupted')}</li>
          <li>{t(locale, 'pages.terms.disclaimers.no_guarantee.bugs')}</li>
          <li>{t(locale, 'pages.terms.disclaimers.no_guarantee.secure')}</li>
          <li>{t(locale, 'pages.terms.disclaimers.no_guarantee.accuracy')}</li>
        </ul>

        <h3>{t(locale, 'pages.terms.disclaimers.liability.title')}</h3>
        <p>{t(locale, 'pages.terms.disclaimers.liability.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.disclaimers.liability.access')}</li>
          <li>{t(locale, 'pages.terms.disclaimers.liability.third_party')}</li>
          <li>{t(locale, 'pages.terms.disclaimers.liability.unauthorized')}</li>
        </ul>

        <h2>{t(locale, 'pages.terms.data_loss.title')}</h2>
        <p>{t(locale, 'pages.terms.data_loss.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.data_loss.clear')}</li>
          <li>{t(locale, 'pages.terms.data_loss.uninstall')}</li>
          <li>{t(locale, 'pages.terms.data_loss.device')}</li>
          <li>{t(locale, 'pages.terms.data_loss.reset')}</li>
        </ul>
        <p set:html={t(locale, 'pages.terms.data_loss.backup')} />

        <h2>{t(locale, 'pages.terms.availability.title')}</h2>
        <p>{t(locale, 'pages.terms.availability.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.availability.maintenance')}</li>
          <li>{t(locale, 'pages.terms.availability.technical')}</li>
          <li>{t(locale, 'pages.terms.availability.circumstances')}</li>
        </ul>

        <h2>{t(locale, 'pages.terms.modifications.title')}</h2>

        <h3>{t(locale, 'pages.terms.modifications.service.title')}</h3>
        <p>{t(locale, 'pages.terms.modifications.service.content')}</p>

        <h3>{t(locale, 'pages.terms.modifications.terms.title')}</h3>
        <p>{t(locale, 'pages.terms.modifications.terms.content')}</p>

        <h2>{t(locale, 'pages.terms.termination.title')}</h2>
        <p>{t(locale, 'pages.terms.termination.content')}</p>

        <h2>{t(locale, 'pages.terms.external_links.title')}</h2>
        <p>{t(locale, 'pages.terms.external_links.content')}</p>

        <h2>{t(locale, 'pages.terms.indemnification.title')}</h2>
        <p>{t(locale, 'pages.terms.indemnification.content')}</p>
        <ul>
          <li>{t(locale, 'pages.terms.indemnification.use')}</li>
          <li>{t(locale, 'pages.terms.indemnification.violation')}</li>
          <li>{t(locale, 'pages.terms.indemnification.rights')}</li>
          <li>{t(locale, 'pages.terms.indemnification.user_content')}</li>
        </ul>

        <h2>{t(locale, 'pages.terms.governing_law.title')}</h2>
        <p>{t(locale, 'pages.terms.governing_law.content')}</p>

        <h2>{t(locale, 'pages.terms.severability.title')}</h2>
        <p>{t(locale, 'pages.terms.severability.content')}</p>

        <h2>{t(locale, 'pages.terms.entire_agreement.title')}</h2>
        <p>{t(locale, 'pages.terms.entire_agreement.content')}</p>

        <div class="contact-info">
          <h2>{t(locale, 'pages.terms.contact.title')}</h2>
          <p>{t(locale, 'pages.terms.contact.intro')}</p>
          <ul>
            <li><strong>{t(locale, 'pages.terms.contact.email_label')}</strong> <a href="mailto:support@mapmyroots.com">support@mapmyroots.com</a></li>
            <li><strong>{t(locale, 'pages.terms.contact.website_label')}</strong> <a href="https://mapmyroots.com">mapmyroots.com</a></li>
          </ul>
        </div>

        <div class="highlight-box">
          <p set:html={t(locale, 'pages.terms.thank_you')} />
        </div>
      </div>
    </div>
</BaseLayout>
