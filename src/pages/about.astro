---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const title = t(locale, 'pages.about.meta.title');
const description = t(locale, 'pages.about.meta.description');

const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "MapMyRoots",
  "url": "https://mapmyroots.com",
  "logo": "https://mapmyroots.com/logo.png",
  "description": "Free family tree builder and genealogy software for preserving family history"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mapmyroots.com/" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://mapmyroots.com/about" }
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/about"
  locale={locale}
  jsonLd={[orgSchema, breadcrumbSchema]}
>
    <div class="about-container">
      <div class="about-hero">
        <h1>{t(locale, 'pages.about.hero.title')}</h1>
        <p class="subtitle">{t(locale, 'pages.about.hero.subtitle')}</p>
      </div>

      <div class="mission-box">
        <h2>{t(locale, 'pages.about.mission.title')}</h2>
        <p>{t(locale, 'pages.about.mission.content')}</p>
      </div>

      <div class="story-section">
        <h2>{t(locale, 'pages.about.story.title')}</h2>
        <p>{t(locale, 'pages.about.story.paragraph1')}</p>
        <p>{t(locale, 'pages.about.story.paragraph2')}</p>
        <p>{t(locale, 'pages.about.story.paragraph3')}</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">🔒</div>
          <h3>{t(locale, 'pages.about.values.privacy.title')}</h3>
          <p>{t(locale, 'pages.about.values.privacy.content')}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">💯</div>
          <h3>{t(locale, 'pages.about.values.free.title')}</h3>
          <p>{t(locale, 'pages.about.values.free.content')}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">✨</div>
          <h3>{t(locale, 'pages.about.values.simple.title')}</h3>
          <p>{t(locale, 'pages.about.values.simple.content')}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🌍</div>
          <h3>{t(locale, 'pages.about.values.accessible.title')}</h3>
          <p>{t(locale, 'pages.about.values.accessible.content')}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🎨</div>
          <h3>{t(locale, 'pages.about.values.beautiful.title')}</h3>
          <p>{t(locale, 'pages.about.values.beautiful.content')}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🔓</div>
          <h3>{t(locale, 'pages.about.values.ownership.title')}</h3>
          <p>{t(locale, 'pages.about.values.ownership.content')}</p>
        </div>
      </div>

      <div class="stats-section">
        <h2>{t(locale, 'pages.about.stats.title')}</h2>
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-number">3</div>
            <div class="stat-label">{t(locale, 'pages.about.stats.formats')}</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">{t(locale, 'pages.about.stats.free')}</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">0</div>
            <div class="stat-label">{t(locale, 'pages.about.stats.accounts')}</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">4</div>
            <div class="stat-label">{t(locale, 'pages.about.stats.languages')}</div>
          </div>
        </div>
      </div>

      <div class="story-section">
        <h2>{t(locale, 'pages.about.why_free.title')}</h2>
        <p>{t(locale, 'pages.about.why_free.paragraph1')}</p>
        <ul style="font-size: 1.1rem; line-height: 1.8; color: var(--text-primary); margin-left: 2rem;">
          <li set:html={t(locale, 'pages.about.why_free.reason1')} />
          <li set:html={t(locale, 'pages.about.why_free.reason2')} />
          <li set:html={t(locale, 'pages.about.why_free.reason3')} />
          <li set:html={t(locale, 'pages.about.why_free.reason4')} />
        </ul>
        <p>{t(locale, 'pages.about.why_free.paragraph2')}</p>
      </div>

      <div class="story-section">
        <h2>{t(locale, 'pages.about.technology.title')}</h2>
        <p>{t(locale, 'pages.about.technology.paragraph1')}</p>
        <ul style="font-size: 1.1rem; line-height: 1.8; color: var(--text-primary); margin-left: 2rem;">
          <li set:html={t(locale, 'pages.about.technology.canvas')} />
          <li set:html={t(locale, 'pages.about.technology.localstorage')} />
          <li set:html={t(locale, 'pages.about.technology.responsive')} />
          <li set:html={t(locale, 'pages.about.technology.export')} />
          <li set:html={t(locale, 'pages.about.technology.i18n')} />
        </ul>
      </div>

      <div class="cta-section">
        <h2>{t(locale, 'pages.about.cta.title')}</h2>
        <p>{t(locale, 'pages.about.cta.content')}</p>
        <a href="/builder" class="btn-primary btn-large">
          <span>{t(locale, 'pages.about.cta.button')}</span>
        </a>
      </div>
    </div>
</BaseLayout>
